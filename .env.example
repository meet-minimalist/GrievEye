TELEGRAM_BOT_TOKEN=123456:your-token-from-botfather
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your API key is not scoped to a workspace
# (error: "must include the anthropic-workspace-id header").
ANTHROPIC_WORKSPACE_ID=
# Optional second bot for officers (create it in @BotFather). Without it, officer
# alerts come through the citizen bot.
OFFICER_BOT_TOKEN=
# Telegram chat that receives cases for any post nobody has claimed with /officer.
# Get it with: python get_officer_chat_id.py, or send /myid to the bot
OFFICER_CHAT_ID=
# base (fast, ~75 MB) or small (better Kannada, ~480 MB)
WHISPER_MODEL=base
DASHBOARD_PORT=8000
# Optional: the address phones use for /mydashboard links. Default: a running tunnel, else this laptop's Wi-Fi IP.
DASHBOARD_URL=
# Optional: other laptops (their IP addresses, comma-separated) that may open /demo and use the
# DC controls (triage routing, +48 h). Example: DEMO_ALLOWED_IPS=172.16.0.57
DEMO_ALLOWED_IPS=
# Spam: after this many spam marks in 90 days, a citizen cannot file complaints
# for SPAM_BAN_DAYS days (0 = permanent). An appeal that is accepted removes the mark.
SPAM_BAN_THRESHOLD=3
SPAM_BAN_DAYS=30
